# Neon/Vercel: use the pooled connection string to a database named crysmona, e.g.
# postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/crysmona?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5436/crysmona
API_PORT=4000
# Production: the exact https:// storefront domain (e.g. https://crysmona.vercel.app).
WEB_ORIGIN=http://localhost:5173
DEMO_OTP=123456
# Logging: debug | info | warn | error. Default is debug locally, info in production.
# Production/Vercel logs are one JSON object per line; locally they are readable text.
# LOG_LEVEL=info

# PayPal: server-only credentials. Use sandbox for testing.
# Get these from developer.paypal.com > Apps & Credentials (Sandbox).
# PAYPAL_ENV: sandbox | live. WEB_ORIGIN builds PayPal return/cancel URLs.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_CURRENCY=USD
# Webhook ID shown after adding a webhook to the same PayPal app (Apps & Credentials >
# your app > Webhooks). URL: https://<public host>/api/paypal/webhook, events:
# CHECKOUT.ORDER.APPROVED, PAYMENT.CAPTURE.COMPLETED, PAYMENT.CAPTURE.DENIED,
# PAYMENT.CAPTURE.DECLINED. It collects payments from customers who approve on PayPal
# but never return to the store, and settles payments PayPal held for review. PayPal cannot reach localhost: test
# locally through a tunnel (cloudflared/ngrok) to the API port.
PAYPAL_WEBHOOK_ID=

# Twilio Verify: SMS OTP for phone login. Server-only credentials.
# Get these from console.twilio.com (Account Info) and Verify > Services.
# Trial accounts only deliver to Verified Caller IDs. Leave blank to keep the
# development demo code; production phone login stays disabled until set.
# OTP_COUNTRY_CODE is prefixed to the 10-digit number entered at login.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
OTP_COUNTRY_CODE=+91

# ---------------------------------------------------------------------------
# Media storage (admin image and video uploads). Server-only: never expose these values.
#
# You can configure several storages. Each one is a numbered block of
# STORAGE_<n>_* variables (STORAGE_1_*, STORAGE_2_*, ...). Supported types:
#   vercel-blob  Vercel Blob
#   r2           Cloudflare R2
#   s3           Amazon S3
#   custom       any other S3-compatible service (MinIO, Backblaze B2,
#                DigitalOcean Spaces, ...)
#
# STORAGE_ACTIVE is the number of the storage that receives NEW uploads.
#   - Leave it unset to use the lowest-numbered storage.
#   - Changing it (then restarting the API / redeploying) switches where new
#     uploads go. Images uploaded earlier keep their full URL in the database
#     and still load from the storage they were uploaded to, so keep it public.
#   - If it names a storage that is not configured, the API refuses to start.
#
# Every storage block:
#   STORAGE_<n>_TYPE        vercel-blob | r2 | s3 | custom        (required)
#   STORAGE_<n>_NAME        label shown in logs, e.g. "Amazon S3 Mumbai" (optional)
#
# vercel-blob only needs a token:
#   STORAGE_<n>_TOKEN       read/write token of the Blob store. If left empty,
#                           BLOB_READ_WRITE_TOKEN is used (Vercel adds that
#                           automatically when a Blob store is connected).
#   Image URLs are returned by Vercel (https://<id>.public.blob.vercel-storage.com/...).
#
# r2 / s3 / custom need:
#   STORAGE_<n>_BUCKET      bucket name
#   STORAGE_<n>_KEY_ID      access key ID
#   STORAGE_<n>_SECRET      secret access key
#   STORAGE_<n>_PUBLIC_URL  HTTPS base URL images are served from, e.g.
#                           https://images.example.com, https://pub-xxx.r2.dev,
#                           or a CloudFront URL. Using your own domain lets you
#                           move buckets later without rewriting saved image URLs.
#   plus, depending on TYPE:
#     r2      STORAGE_<n>_ACCOUNT_ID  Cloudflare account ID (endpoint is built for you)
#     s3      STORAGE_<n>_REGION      AWS region, e.g. ap-south-1
#     custom  STORAGE_<n>_ENDPOINT    S3 API URL, e.g. https://s3.us-west-004.backblazeb2.com
#             STORAGE_<n>_REGION      region the service expects (MinIO: us-east-1)
#
# Uploads go straight from the browser to the ACTIVE storage via a signed URL,
# so it must be r2, s3 or custom (vercel-blob only serves older files). Limits:
# images JPEG/PNG/WebP up to 8 MB, videos MP4/WebM up to 50 MB. The bucket needs
# a CORS rule allowing PUT with the content-type header from WEB_ORIGIN.
# Full production guide: docs/r2-production-setup.md
#
# Rules:
#   - Every declared storage is checked at startup; a missing value stops the API.
#     To retire a storage, delete its whole block.
#   - Never renumber or reuse a number once it has been used; add the next one.
#   - Give each key/token write access only to its own bucket or store.
#
# Leave everything blank to disable uploads (the admin shows a clear error).
# The older single-bucket R2_* variables (R2_ACCOUNT_ID, R2_ACCESS_KEY_ID,
# R2_SECRET_ACCESS_KEY, R2_BUCKET_NAME, R2_PUBLIC_URL) still work as storage 1
# when no STORAGE_<n>_* variables are set.
# ---------------------------------------------------------------------------
# Examples below are commented out so a copied .env still starts. Uncomment a
# block and fill in every value to enable it.
# STORAGE_ACTIVE=1

# Storage 1: Vercel Blob
# Vercel > Project > Storage > Create > Blob, then connect it to the project.
# Vercel adds BLOB_READ_WRITE_TOKEN to the deployment automatically; locally,
# copy the same value from the store's .env.local tab (Show secret) so both
# environments use identical variables. No STORAGE_1_TOKEN is needed.
# Only one Blob store can use BLOB_READ_WRITE_TOKEN; a second vercel-blob
# storage must set its own STORAGE_<n>_TOKEN.
# STORAGE_1_TYPE=vercel-blob
# STORAGE_1_NAME=Vercel Blob
# BLOB_READ_WRITE_TOKEN=

# Storage 2: Cloudflare R2 (set STORAGE_ACTIVE=2 to send new uploads here)
# STORAGE_2_TYPE=r2
# STORAGE_2_NAME=Cloudflare R2
# STORAGE_2_ACCOUNT_ID=
# STORAGE_2_BUCKET=
# STORAGE_2_KEY_ID=
# STORAGE_2_SECRET=
# STORAGE_2_PUBLIC_URL=

# Storage 3: Amazon S3 (set STORAGE_ACTIVE=3 to send new uploads here)
# STORAGE_3_TYPE=s3
# STORAGE_3_NAME=Amazon S3
# STORAGE_3_REGION=ap-south-1
# STORAGE_3_BUCKET=
# STORAGE_3_KEY_ID=
# STORAGE_3_SECRET=
# STORAGE_3_PUBLIC_URL=

# Admin requests: exact HTTPS storefront origin is required in production.
# Set TRUST_PROXY only behind a known reverse proxy that overwrites forwarded headers.
# Example for a proxy on this same machine: TRUST_PROXY=loopback
# Leave unset when clients connect directly to Express.
# ADMIN_EMAIL and ADMIN_PASSWORD are optional inputs to admin:create/admin:reset.
# Prefer the interactive hidden password prompt; do not commit admin passwords.

# Development bootstrap admin (change after first login)
DEFAULT_ADMIN_EMAIL=admin@crysmona.com
DEFAULT_ADMIN_PASSWORD=CrysmonaAdmin@2026
